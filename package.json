{
  "name": "claude-agent-sdk-s01-query",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "First Claude Agent SDK lesson: one query(), no tools",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "dev": "npm start",
    "agent": "tsx --env-file-if-exists=.env src/cli.ts",
    "build:client": "tsc -p tsconfig.client.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && tsx --test src/agent.test.ts src/startup.test.ts"
  },
  "dependencies": { "@anthropic-ai/claude-agent-sdk": "0.3.310" },
  "devDependencies": { "@types/node": "^24.0.0", "tsx": "^4.20.6", "typescript": "^5.9.3" }
}
